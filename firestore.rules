rules_version = '2';

// ABUD Portfolio: Firestore security rules.
//
// The app has NO SIGN-IN by design (internal reporting tool). These rules therefore cannot tell
// who is calling: anyone who has the app's address can read and change these collections.
// What the rules do: allow only the app's collections, and reject malformed data
// (money and rates must be decimal strings, dates YYYY-MM-DD, known instrument and transaction types).
//
// Collections are described in firestore/MODEL.md.

service cloud.firestore {
  match /databases/{database}/documents {

    function isDate(v) { return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }
    function isMoney(v) { return v is string && v.matches('^-?[0-9]+([.][0-9]{1,2})?$'); }
    function isPositiveMoney(v) { return isMoney(v) && !v.matches('^-.*') && !v.matches('^0+([.]0+)?$'); }
    function isRate(v) { return v is string && v.matches('^[0-9]+([.][0-9]+)?$'); }
    function isSignedRate(v) { return v is string && v.matches('^-?[0-9]+([.][0-9]+)?$'); }

    match /transactions/{id} {
      function valid(d) {
        return d.type in ['inflow', 'withdrawal', 'fee_debit', 'invest', 'mature', 'rollover',
                          'interest', 'fund_subscription', 'fund_redemption']
          && isDate(d.date)
          && (d.type == 'rollover' ? isMoney(d.amount) : isPositiveMoney(d.amount))
          && (!(d.type in ['invest', 'mature', 'rollover', 'fund_subscription', 'fund_redemption'])
              || d.instrumentId is string);
      }
      allow read, delete: if true;
      allow create, update: if valid(request.resource.data);
    }

    match /instruments/{id} {
      function valid(d) {
        return d.type in ['ntb', 'omo', 'commercial_paper', 'fixed_deposit', 'call_deposit', 'money_market_fund']
          && isPositiveMoney(d.cost)
          && isDate(d.valueDate)
          && (d.type == 'money_market_fund' || (isDate(d.maturityDate) && d.maturityDate > d.valueDate))
          && (!(d.type in ['ntb', 'omo', 'commercial_paper']) || isPositiveMoney(d.faceValue))
          && (!(d.type in ['fixed_deposit', 'call_deposit']) || isRate(d.rate))
          && (d.type != 'money_market_fund' || (d.fundId is string && d.pricingBasis in ['price', 'yield']))
          && (!('discountRate' in d) || isRate(d.discountRate));
      }
      allow read, delete: if true;
      allow create, update: if valid(request.resource.data);
    }

    match /mandateTerms/{effectiveFrom} {
      allow read: if true;
      allow write: if isDate(effectiveFrom)
        && request.resource.data.effectiveFrom == effectiveFrom
        && isRate(request.resource.data.mgmtFeeRate)
        && isRate(request.resource.data.incentiveRate)
        && isRate(request.resource.data.hurdleSpread)
        && request.resource.data.incentiveReading in ['clause_8', 'clause_12'];
    }

    match /funds/{id} {
      allow read: if true;
      allow write: if request.resource.data.name is string
        && request.resource.data.pricingBasis in ['price', 'yield'];
    }

    match /fundPrices/{id} {
      allow read, delete: if true;
      allow create, update: if isDate(request.resource.data.date)
        && request.resource.data.fundId is string
        && isRate(request.resource.data.priceOrYield);
    }

    // Change history: one document per change, holding each touched document before and after.
    // Append-only, so a mistake can always be traced and undone.
    match /audit/{id} {
      allow read: if true;
      allow create: if request.resource.data.summary is string
        && request.resource.data.kind in ['edit', 'delete', 'restore']
        && request.resource.data.changes is list
        && request.resource.data.at == request.time;
      allow update, delete: if false;
    }

    // App settings: one 'limits' document holding the alert thresholds and deal limits.
    match /settings/{id} {
      allow read: if true;
      allow write: if id == 'limits'
        && isMoney(request.resource.data.idleCash)
        && isRate(request.resource.data.liquidityShare)
        && isRate(request.resource.data.concentrationShare)
        && request.resource.data.maxTenorDays.matches('^[0-9]+$')
        && request.resource.data.idleDays.matches('^[0-9]+$');
    }

    // Quarter close records: one per closed quarter (id = label, e.g. 2026Q3). Deleting one reopens the quarter.
    match /quarterlyResults/{id} {
      function valid(d) {
        return id.matches('^[0-9]{4}Q[1-4]$') && d.quarter == id
          && isDate(d.periodStart) && isDate(d.periodEnd)
          && isSignedRate(d.arip) && isRate(d.watbr) && isRate(d.hurdle)
          && isMoney(d.mgmtFee) && isMoney(d.incentiveClause8) && isMoney(d.incentiveClause12)
          && d.hurdleMet is bool && d.status in ['closed', 'billed'];
      }
      allow read, delete: if true;
      allow create, update: if valid(request.resource.data);
    }

    // Market data: written by the scheduled feed job (tools/feeds) and by hand on the Market screen.
    match /auctions/{id} {
      allow read, delete: if true;
      allow create, update: if request.resource.data.kind in ['ntb', 'omo']
        && isDate(request.resource.data.date)
        && request.resource.data.tenorDays.matches('^[0-9]+$')
        && isRate(request.resource.data.stopRate);
    }
    match /mpc/{id} {
      allow read, delete: if true;
      allow create, update: if isDate(id) && request.resource.data.date == id && isRate(request.resource.data.mpr);
    }
    match /cpQuotes/{id} {
      allow read, delete: if true;
      allow create, update: if isDate(request.resource.data.date)
        && request.resource.data.confirmed is bool
        && (!('yield' in request.resource.data) || isRate(request.resource.data.yield));
    }
    match /feedStatus/{id} {
      allow read: if true;
      allow write: if id in ['cbn_ntb', 'cbn_omo', 'cbn_mpc', 'fmdq_cp', 'cbn_cpi'];
    }

    // Everything else is closed.
  }
}
